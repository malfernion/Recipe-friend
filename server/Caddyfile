# Stands in for Supabase's API gateway, and serves the site from the same
# origin so there is no CORS to configure. The three APIs are mounted where
# supabase-js expects them, with the prefix stripped before it reaches the
# service, exactly as Supabase's own gateway does.
{
	auto_https off
	admin off
}

:80 {
	handle_path /auth/v1/* {
		# An assistant signing in asks for a scope, and GoTrue's OAuth
		# server knows only OIDC's. `openid` would have it make an ID
		# token, which it cannot sign with this stack's HS256 secret, and
		# the token request fails. The scope decides nothing here (the
		# agent role does), so every request asks for the one the MCP
		# server advertises, whatever the client chose.
		@authorize path /oauth/authorize
		uri @authorize query scope email
		reverse_proxy auth:9999 {
			header_up X-Forwarded-Prefix /auth/v1
		}
	}

	# How an MCP client finds where to sign in (J17.15). The 401 from /mcp
	# points at the protected-resource metadata (RFC 9728), which the mcp
	# service serves; that names GoTrue's issuer, …/auth/v1, whose own
	# metadata a client looks for with the issuer's path appended to the
	# well-known one (RFC 8414 and OIDC), or at the root as older clients
	# do. GoTrue serves it at /auth/v1/.well-known/… already; these are the
	# other places it is looked for.
	@resource_metadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @resource_metadata {
		reverse_proxy mcp:3100
	}
	@as_metadata path /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/auth/v1
	handle @as_metadata {
		rewrite * /.well-known/oauth-authorization-server
		reverse_proxy auth:9999 {
			header_up X-Forwarded-Prefix /auth/v1
		}
	}
	@oidc_metadata path /.well-known/openid-configuration /.well-known/openid-configuration/auth/v1
	handle @oidc_metadata {
		rewrite * /.well-known/openid-configuration
		reverse_proxy auth:9999 {
			header_up X-Forwarded-Prefix /auth/v1
		}
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000 {
			header_up X-Forwarded-Prefix /rest/v1
		}
	}

	handle_path /storage/v1/* {
		reverse_proxy storage:5000 {
			header_up X-Forwarded-Prefix /storage/v1
		}
	}

	# The hosted MCP server (J17). `handle`, not `handle_path`: it is
	# served at /mcp, and the prefix is part of its own route. Nothing
	# here buffers or caches it; each POST is answered on its own.
	handle /mcp {
		reverse_proxy mcp:3100
	}

	# js/config.js is answered from a template filled with this stack's
	# own anon key (RECIPE_FRIEND_ANON_KEY), never from the committed
	# file, which is only the dev default. Production's Caddyfile does the same.
	# no-cache so a changed key is not held by Cloudflare or a browser.
	handle /js/config.js {
		root * /srv/server
		rewrite * /config.js.tmpl
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		templates {
			mime text/javascript
		}
		file_server
	}

	# The site is a handful of files at the root of the repository, and
	# the repository is what is mounted. Serving the whole of it would hand
	# out .git, the tests and this directory, so the site's own files are
	# named and everything else is a 404.
	@site path / /index.html /privacy.html /terms.html /assets/* /css/* /js/*
	handle @site {
		root * /srv
		file_server
	}

	handle {
		respond 404
	}
}
