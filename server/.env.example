# DEVELOPMENT AND CI ONLY. Every value below is a fake, made up for a stack
# that runs on 127.0.0.1 and holds nothing, and is committed on purpose so
# `cp server/.env.example server/.env` is the whole of the setup.
#
# Never reuse any of it for a stack anybody else can reach. Production
# secrets are generated on the server and never committed; the homelab
# stack's own .env.example lists the names with empty values.

# The address the browser uses for this stack: Caddy, on loopback.
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

POSTGRES_PASSWORD=local-dev-only-postgres-password

# HS256 secret that signs every session token. The two keys below are
# long-lived tokens signed with it, for the roles `anon` and
# `service_role`. They were generated from this secret; change the secret
# and they stop working.
JWT_SECRET=recipe-friend-local-dev-only-jwt-secret-do-not-use-in-production
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkyMjgxNjAwLCJleHAiOjQxMDI0NDQ4MDB9.eFkUpKSXGHT_K3a7_0Snj3iYPNI0PMVX114f7YmtjT8
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3OTIyODE2MDAsImV4cCI6NDEwMjQ0NDgwMH0.SuB_zrvBrG7x4j38kruuRaX5JwVMZKnFsiQpdx-GPxw

# Where GoTrue may send a browser back to after sign-in, besides PUBLIC_URL.
ADDITIONAL_REDIRECT_URLS=http://localhost:8000
ENABLE_EMAIL_SIGNUP=true
